# Local development: SQLite. Laboratory Compose uses .lab/lab.env instead.
DJANGO_SETTINGS_MODULE=dcrm.settings.dev
SECRET_KEY=replace-with-a-local-development-key
ALLOWED_HOSTS=localhost,127.0.0.1
# For explicit MySQL outside Compose, select dcrm.settings.lab and supply:
# DB_NAME=crm_lab
# DB_USER=crm_runtime
# DB_PASSWORD=<private laboratory password>
# DB_HOST=127.0.0.1
# DB_PORT=3306
FORENSIC_CASE_TAG=
FORENSIC_TRUSTED_PROXIES=
